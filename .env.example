# Copy to .env for local development:  cp .env.example .env
# Every setting is optional except DJANGO_SECRET_KEY when DJANGO_DEBUG=False.
# Defaults are production-safe; the values below relax them for localhost.

# --- core
DJANGO_DEBUG=True
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False

# --- data (defaults to ./db.sqlite3 when unset)
# DATABASE_URL=postgres://app:app@localhost:5432/app
# REDIS_URL=redis://localhost:6379/0

# --- auth
# JWT_SIGNING_KEY=            # defaults to DJANGO_SECRET_KEY; >= 32 chars
# JWT_ACCESS_TTL_MINUTES=5
# JWT_REFRESH_TTL_DAYS=1
# PASSWORD_MIN_LENGTH=12
# INVITATION_TTL_HOURS=72
# FRONTEND_INVITE_URL=http://localhost:3000/accept-invite?token={token}

# --- rate limits (DRF syntax: N/sec|min|hour|day)
# THROTTLE_AUTH=10/min
# THROTTLE_ANON=60/min
# THROTTLE_USER=600/min

# --- networking
# NUM_PROXIES=0               # trusted reverse proxies in front of the app
# DJANGO_BEHIND_TLS_PROXY=False

# --- observability
# console is human-friendly; use json (the default) in production
LOG_FORMAT=console
# LOG_LEVEL=INFO
# API_DOCS_ENABLED=True
